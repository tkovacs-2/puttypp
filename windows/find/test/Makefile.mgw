
CC = $(TOOLPATH)gcc

OBJDIR := obj
PUTTY := putty-0.85

CFLAGS = -Wall -O0 -std=gnu99 -Wvla -D_WINDOWS -DWIN32S_COMPAT -g\
		-D_NO_OLDNAMES -D__USE_MINGW_ANSI_STDIO=1 \
		-DHAVE_STRTOUMAX=1 \
		-DHAVE_ADDDLLDIRECTORY=1 \
		-DHAVE_AFUNIX_H=1 \
		-DHAVE_SETDEFAULTDLLDIRECTORIES=1 \
		-DHAVE_GCP_RESULTSW=1 \
		-I../../../$(PUTTY)/ \
		-I../../../$(PUTTY)/terminal \
		-I../../../$(PUTTY)/windows \
		-I../../../windows \
		-I../../../windows/find \
		-I../../../windows/find/test

LDFLAGS = --static -g

# _WIN32_IE is required to expose identifiers that only make sense on
# systems with IE5+ installed, such as some arguments to SHGetFolderPath().
# WINVER etc perform a similar function for FlashWindowEx().
CFLAGS += -D_WIN32_IE=0x0500
CFLAGS += -DWINVER=0x0500 -D_WIN32_WINDOWS=0x0410 -D_WIN32_WINNT=0x0500

.SUFFIXES:

SOURCES := ../../../$(PUTTY)/callback.c \
           ../../../$(PUTTY)/ldisc.c \
           ../../../$(PUTTY)/logging.c \
           ../../../$(PUTTY)/settings.c \
           ../../../$(PUTTY)/stubs/no-gss.c \
           ../../../$(PUTTY)/stubs/no-print.c \
           ../../../$(PUTTY)/stubs/no-timing.c \
           ../../../$(PUTTY)/terminal/bidi.c \
           ../../../$(PUTTY)/terminal/lineedit.c \
           ../../../$(PUTTY)/utils/base64_decode.c \
           ../../../$(PUTTY)/utils/base64_decode_atom.c \
           ../../../$(PUTTY)/utils/base64_encode.c \
           ../../../$(PUTTY)/utils/base64_encode_atom.c \
           ../../../$(PUTTY)/utils/bufchain.c \
           ../../../$(PUTTY)/utils/burnstr.c \
           ../../../$(PUTTY)/utils/burnwcs.c \
           ../../../$(PUTTY)/utils/cert-expr.c \
           ../../../$(PUTTY)/utils/conf.c \
           ../../../$(PUTTY)/utils/conf_data.c \
           ../../../$(PUTTY)/utils/conf_dest.c \
           ../../../$(PUTTY)/utils/conf_launchable.c \
           ../../../$(PUTTY)/utils/ctrlparse.c \
           ../../../$(PUTTY)/utils/dupcat.c \
           ../../../$(PUTTY)/utils/dupprintf.c \
           ../../../$(PUTTY)/utils/dupstr.c \
           ../../../$(PUTTY)/utils/dupwcs.c \
           ../../../$(PUTTY)/utils/dup_mb_to_wc.c \
           ../../../$(PUTTY)/utils/dup_wc_to_mb.c \
           ../../../$(PUTTY)/utils/decode_utf8.c \
           ../../../$(PUTTY)/utils/decode_utf8_to_wchar.c \
           ../../../$(PUTTY)/utils/decode_utf8_to_wide_string.c \
           ../../../$(PUTTY)/utils/encode_utf8.c \
           ../../../$(PUTTY)/utils/encode_wide_string_as_utf8.c \
           ../../../$(PUTTY)/utils/host_ca_new_free.c \
           ../../../$(PUTTY)/utils/ltime.c \
           ../../../$(PUTTY)/utils/make_spr_sw_abort_static.c \
           ../../../$(PUTTY)/utils/marshal.c \
           ../../../$(PUTTY)/utils/memory.c \
           ../../../$(PUTTY)/utils/out_of_memory.c \
           ../../../$(PUTTY)/utils/percent_decode.c \
           ../../../$(PUTTY)/utils/percent_encode.c \
           ../../../$(PUTTY)/utils/prompts.c \
           ../../../$(PUTTY)/utils/ptrlen.c \
           ../../../$(PUTTY)/utils/smemclr.c \
           ../../../$(PUTTY)/utils/strbuf.c \
           ../../../$(PUTTY)/utils/tree234.c \
           ../../../$(PUTTY)/utils/wcwidth.c \
           ../../../$(PUTTY)/utils/wildcard.c \
           ../../../$(PUTTY)/windows/unicode.c \
           ../../../$(PUTTY)/windows/storage.c \
           ../../../$(PUTTY)/windows/no-jump-list.c \
           ../../../$(PUTTY)/windows/utils/blink_time.c \
           ../../../$(PUTTY)/windows/utils/defaults.c \
           ../../../$(PUTTY)/windows/utils/escape_registry_key.c \
           ../../../$(PUTTY)/windows/utils/filename.c \
           ../../../$(PUTTY)/windows/utils/fontspec.c \
           ../../../$(PUTTY)/windows/utils/get_username.c \
           ../../../$(PUTTY)/windows/utils/get_system_dir.c \
           ../../../$(PUTTY)/windows/utils/load_system32_dll.c \
           ../../../$(PUTTY)/windows/utils/open_for_write_would_lose_data.c \
           ../../../$(PUTTY)/windows/utils/registry.c \
           ../../../$(PUTTY)/windows/utils/win_strerror.c \
           ../../../windows/terminal_public.c \
           ../../../windows/find/kmp.c \
           ../../../windows/find/finditerator.c \
           ../../../windows/find/find.c \
           ../../../windows/find/ucase.c \
           ../../../windows/find/uchar.c \
           ../../../windows/find/test/testkmp.c \
           ../../../windows/find/test/testfind.c \
           ../../../windows/find/test/testunicode.c \
           ../../../windows/find/test/main.c

getobjdir = $(patsubst %,$(OBJDIR)/%.$(2),$(subst /,__,$(subst $(PUTTY)/,,$(subst ../../../,,$(basename $(1))))))

$(OBJDIR):
	mkdir -p $(OBJDIR)

OBJECTS := $(call getobjdir,$(SOURCES),o)
DFILES := $(call getobjdir,$(SOURCES),d)

-include $(DFILES)

$(foreach SOURCE,$(SOURCES),$(eval $(call getobjdir,$(SOURCE),o): SOURCE := $(SOURCE)))
$(OBJECTS): | $(OBJDIR)
	$(CC) $(COMPAT) $(CFLAGS) $(XFLAGS) -MMD -MF $(@:.o=.d) -c $(SOURCE) -o $@

findtest.exe: $(OBJECTS)
	$(CC) $(LDFLAGS) -o $@ $^

clean:
	rm -rf $(OBJDIR) *.exe

FORCE:
