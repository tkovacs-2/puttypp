#include "stubdialog_res.h"
#include "putty-rc.h"

IDD_RECONF DIALOG DISCARDABLE 100, 20, 220, 222
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Host", -1, 14, 26, 70, 8
    EDITTEXT IDC_CONF_HOST, 96, 24, 110, 12, ES_AUTOHSCROLL
    LTEXT "Session name", -1, 14, 10, 70, 8
    EDITTEXT IDC_CONF_SESSION_NAME, 96, 8, 110, 12, ES_AUTOHSCROLL

    GROUPBOX "Resize action", -1, 7, 40, 206, 48
    AUTORADIOBUTTON "Disabled", IDC_CONF_RESIZE_DISABLED, 14, 53, 50, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Resize terminal", IDC_CONF_RESIZE_TERM, 74, 53, 65, 10
    AUTORADIOBUTTON "Resize font", IDC_CONF_RESIZE_FONT, 144, 53, 55, 10
    AUTORADIOBUTTON "Resize either", IDC_CONF_RESIZE_EITHER, 14, 69, 60, 10

    LTEXT "Width", -1, 14, 97, 70, 8
    EDITTEXT IDC_CONF_WIDTH, 96, 95, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Height", -1, 14, 113, 70, 8
    EDITTEXT IDC_CONF_HEIGHT, 96, 111, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Font height", -1, 14, 129, 70, 8
    EDITTEXT IDC_CONF_FONTSPEC_HEIGHT, 96, 127, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Window border", -1, 14, 145, 70, 8
    EDITTEXT IDC_CONF_WINDOW_BORDER, 96, 143, 40, 12, ES_NUMBER | ES_AUTOHSCROLL

    AUTOCHECKBOX "Scrollbar", IDC_CONF_SCROLLBAR, 14, 165, 70, 10
    AUTOCHECKBOX "Scrollbar in fullscreen", IDC_CONF_SCROLLBAR_FULLSCREEN, 96, 165, 100, 10
    AUTOCHECKBOX "Sunken edge", IDC_CONF_SUNKEN_EDGE, 14, 179, 70, 10
    AUTOCHECKBOX "Try palette", IDC_CONF_TRY_PALETTE, 96, 179, 70, 10
    AUTOCHECKBOX "Hide mouse pointer", IDC_CONF_HIDE_MOUSEPTR, 14, 193, 120, 10

    DEFPUSHBUTTON "OK", IDOK, 116, 204, 44, 14
    PUSHBUTTON "Cancel", IDCANCEL, 169, 204, 44, 14
END

IDD_TERM_REMOTE DIALOG DISCARDABLE 100, 20, 220, 166
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Remote terminal changes"
FONT 8, "MS Shell Dlg"
BEGIN
    PUSHBUTTON "Resize", IDC_TERM_REMOTE_RESIZE, 14, 10, 100, 14
    LTEXT "W", -1, 120, 12, 8, 8
    EDITTEXT IDC_TERM_REMOTE_WIDTH, 130, 10, 32, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "H", -1, 166, 12, 8, 8
    EDITTEXT IDC_TERM_REMOTE_HEIGHT, 176, 10, 30, 12, ES_NUMBER | ES_AUTOHSCROLL

    PUSHBUTTON "Maximize", IDC_TERM_REMOTE_MAXIMISE, 14, 32, 192, 14
    PUSHBUTTON "Restore", IDC_TERM_REMOTE_RESTORE, 14, 50, 192, 14
    PUSHBUTTON "Minimized", IDC_TERM_REMOTE_MINIMISE, 14, 68, 192, 14

    PUSHBUTTON "Move", IDC_TERM_REMOTE_MOVE, 14, 86, 100, 14
    LTEXT "X", -1, 120, 88, 8, 8
    EDITTEXT IDC_TERM_REMOTE_X, 130, 86, 32, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Y", -1, 166, 88, 8, 8
    EDITTEXT IDC_TERM_REMOTE_Y, 176, 86, 30, 12, ES_NUMBER | ES_AUTOHSCROLL

    PUSHBUTTON "Z Order Top", IDC_TERM_REMOTE_Z_TOP, 14, 104, 192, 14
    PUSHBUTTON "Z Order Bottom", IDC_TERM_REMOTE_Z_BOTTOM, 14, 122, 192, 14

    AUTOCHECKBOX "Delayed", IDC_TERM_REMOTE_DELAYED, 14, 144, 60, 10

    PUSHBUTTON "Close", IDCANCEL, 169, 144, 44, 14
END
